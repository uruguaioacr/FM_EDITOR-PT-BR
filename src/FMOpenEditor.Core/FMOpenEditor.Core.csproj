<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>FMOpenEditor.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Model\catalog.generated.json" LogicalName="catalog.generated.json" />
    <!-- Not named *.pt-BR.json: MSBuild would treat that as a culture resource and move it to a satellite assembly. -->
    <EmbeddedResource Include="Localization\translation-ptbr.json" LogicalName="i18n.pt-BR.json" WithCulture="false" />
  </ItemGroup>
</Project>
